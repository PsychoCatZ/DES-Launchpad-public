{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DES Launchpad Public",
  "version": "0.2.1",
  "identifier": "ru.kotification.des-launchpad.public",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "DES Launchpad",
        "width": 1000,
        "height": 760,
        "minWidth": 560,
        "minHeight": 440,
        "center": true,
        "visible": false,
        "resizable": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'; base-uri 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico"
    ],
    "resources": {
      "../local/apps.json": "defaults/apps.json",
      "../local/icons/": "defaults/icons/",
      "../local/shortcuts/": "defaults/shortcuts/"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Russian"
        ]
      }
    }
  }
}
